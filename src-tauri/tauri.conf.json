{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tao-nested-repro",
  "version": "0.1.0",
  "identifier": "dev.airodonack.tao-nested-repro",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tao nested loop repro",
        "width": 1200,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
